{
  "name": "qq-email-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-oriented QQ email MCP server built on IMAP and SMTP.",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "qq-email-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "scripts/set-password.mjs",
    "scripts/smoke-test.mjs",
    "qq-email-mcp.example.toml",
    "config/config.example.toml",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "set-password": "node scripts/set-password.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2",
    "@xmldom/xmldom": "0.8.15",
    "imapflow": "^1.0.201",
    "jszip": "3.10.2",
    "mailparser": "^3.7.4",
    "mammoth": "1.12.3",
    "nodemailer": "^7.0.6",
    "pdf-parse": "^1.1.1",
    "sanitize-html": "^2.17.0",
    "smol-toml": "^1.4.2",
    "xlsx": "0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.18.6",
    "@types/nodemailer": "^7.0.2",
    "@types/sanitize-html": "^2.16.0",
    "@vitest/coverage-v8": "^3.2.7",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
